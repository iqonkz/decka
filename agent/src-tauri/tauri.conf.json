{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Decka",
  "version": "0.2.2",
  "identifier": "app.decka.agent",
  "build": {
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Decka",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../client/dist": "client"
    },
    "windows": {
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true
      }
    }
  }
}
