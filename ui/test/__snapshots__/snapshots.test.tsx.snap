exports[`widget markup > AI limits: both providers, one provider at 2x1, the waiting badge 1`] = `"<div class="tile panel" data-tile-id="w1" style="grid-column:1 / span 3;grid-row:1 / span 2"><div class="ai"><div class="ai-limits"><div class="ai-provider"><div class="ai-name">Claude<small class="ai-plan">Max</small></div><div class="ai-window"><div class="ai-line"><span class="ai-label">5h</span><span class="ai-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="62"><span class="ai-fill" style="width:62%;background:var(--accent, #3b82f6)"></span></span><span class="ai-pct">62%</span><span class="ai-reset">resets in 1h 0m</span></div></div><div class="ai-window"><div class="ai-line"><span class="ai-label">7d</span><span class="ai-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="91"><span class="ai-fill" style="width:91%;background:#d97706"></span></span><span class="ai-pct">91%</span><span class="ai-reset">resets in 1d 0h</span></div></div></div><div class="ai-provider"><div class="ai-name">Codex</div><div class="ai-window"><div class="ai-line"><span class="ai-label">30d</span><span class="ai-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4"><span class="ai-fill" style="width:4%;background:var(--accent, #3b82f6)"></span></span><span class="ai-pct">4%</span><span class="ai-reset">resets in 20d 0h</span></div></div></div></div></div></div>"`;

exports[`widget markup > AI limits: both providers, one provider at 2x1, the waiting badge 2`] = `"<div class="tile panel" data-tile-id="w1" style="grid-column:1 / span 2;grid-row:1 / span 1"><div class="ai ai-compact"><div class="ai-limits"><div class="ai-provider"><div class="ai-name">Claude<small class="ai-plan">Max</small></div><div class="ai-window"><div class="ai-line"><span class="ai-label">5h</span><span class="ai-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="62"><span class="ai-fill" style="width:62%;background:var(--accent, #3b82f6)"></span></span><span class="ai-pct">62%</span></div></div><div class="ai-window"><div class="ai-line"><span class="ai-label">7d</span><span class="ai-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="91"><span class="ai-fill" style="width:91%;background:#d97706"></span></span><span class="ai-pct">91%</span></div></div></div></div></div></div>"`;

