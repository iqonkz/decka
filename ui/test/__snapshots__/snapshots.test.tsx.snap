exports[`widget markup > App keys: the keys of the page of the program in front, and the hint without one 1`] = `"<div class="tile" data-tile-id="w1" style="grid-column:1 / span 2;grid-row:1 / span 1"><div class="context" style="display:grid;grid-template-columns:repeat(2, 100px);grid-template-rows:repeat(1, 100px);gap:4px" aria-label="Outlook"><div class="tile" data-tile-id="a" style="grid-column:1 / span 1;grid-row:1 / span 1"><div class="key idle" style="width:100px;height:100px"><div class="key-icon" style="transform:translateY(-7.000000000000001px)"><svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></div><div class="key-label" style="left:7.000000000000001px;right:7.000000000000001px;bottom:7.000000000000001px;font-size:14.000000000000002px">New</div></div></div><div class="tile" data-tile-id="b" style="grid-column:2 / span 1;grid-row:1 / span 1"><div class="key idle" style="width:100px;height:100px"><div class="key-icon" style="transform:translateY(-7.000000000000001px)"><svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg></div><div class="key-label" style="left:7.000000000000001px;right:7.000000000000001px;bottom:7.000000000000001px;font-size:14.000000000000002px">Reply</div></div></div></div></div>"`;

exports[`widget markup > Twitch and YouTube: live and not live 1`] = `"<div class="tile panel" data-tile-id="w1" style="grid-column:1 / span 3;grid-row:1 / span 1"><div class="twitch"><div class="twitch-head"><span class="twitch-dot live"></span><strong class="twitch-state">LIVE</strong><span class="twitch-viewers">42 viewers</span><span class="twitch-time">01:00:00</span></div><div class="twitch-line muted-line">1234 followers</div></div></div>"`;

