{
  "id": "excel",
  "name": "Excel",
  "apps": [
    "excel.exe"
  ],
  "minGrid": {
    "cols": 7,
    "rows": 4
  },
  "actions": {
    "tpl-excel-save": {
      "name": "Save",
      "nameRu": "Сохранить",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "s"
      ]
    },
    "tpl-excel-undo": {
      "name": "Undo",
      "nameRu": "Отменить",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "z"
      ]
    },
    "tpl-excel-redo": {
      "name": "Redo",
      "nameRu": "Повторить",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "y"
      ]
    },
    "tpl-excel-find": {
      "name": "Find",
      "nameRu": "Найти",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "f"
      ]
    },
    "tpl-excel-bold": {
      "name": "Bold",
      "nameRu": "Жирный",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "b"
      ]
    },
    "tpl-excel-filter": {
      "name": "Filter on / off",
      "nameRu": "Фильтр",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "shift",
        "l"
      ]
    },
    "tpl-excel-edit": {
      "name": "Edit cell",
      "nameRu": "Править ячейку",
      "type": "hotkey",
      "keys": [
        "f2"
      ]
    },
    "tpl-excel-fill": {
      "name": "Fill down",
      "nameRu": "Заполнить вниз",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "d"
      ]
    },
    "tpl-excel-format": {
      "name": "Format cells",
      "nameRu": "Формат ячеек",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "1"
      ]
    },
    "tpl-excel-sheet": {
      "name": "New sheet",
      "nameRu": "Новый лист",
      "type": "hotkey",
      "keys": [
        "shift",
        "f11"
      ]
    }
  },
  "items": [
    {
      "id": "save",
      "kind": "button",
      "x": 0,
      "y": 0,
      "w": 1,
      "h": 1,
      "label": "Save",
      "icon": "emoji:💾",
      "actionId": "tpl-excel-save"
    },
    {
      "id": "undo",
