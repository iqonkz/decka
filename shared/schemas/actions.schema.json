{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decka.invalid/schemas/actions.schema.json",
  "$defs": {
    "Key": { "type": "string", "pattern": "^(ctrl|alt|shift|win|[a-z]|[0-9]|f([1-9]|1[0-9]|2[0-4])|enter|esc|space|tab|backspace|delete|home|end|pageup|pagedown|up|down|left|right|printscreen|insert|period|comma|minus|equal|slash|semicolon)$" },
    "Base": { "type": "object", "required": ["name","type"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "toggleVar": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" } } },
    "Hotkey": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["keys"], "properties": { "type": { "const": "hotkey" }, "keys": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/Key" } } } } ] },
    "Media": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["op"], "properties": { "type": { "const": "media" }, "op": { "enum": ["play_pause","next","prev","vol_up","vol_down","mute","shuffle","repeat"] } } } ] },
    "Launch": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["program"], "properties": { "type": { "const": "launch" }, "program": { "type": "string", "minLength": 1, "maxLength": 500 },
      "args": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 500 } }, "cwd": { "type": "string", "maxLength": 500 }, "hidden": { "type": "boolean" } } } ] },
    "OpenUrl": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["url"], "properties": { "type": { "const": "open_url" }, "url": { "type": "string", "pattern": "^https?://", "maxLength": 2000 } } } ] },
    "System": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["op"], "properties": { "type": { "const": "system" }, "op": { "enum": ["lock","sleep","shutdown","restart","signout","hibernate","display_off","task_manager","settings","explorer","empty_recycle_bin"] } } } ] },
    "Audio": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["op"], "properties": { "type": { "const": "audio" }, "op": { "enum": ["mic_toggle","out_mute_toggle"] } } } ] },
    "Obs": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["op"], "properties": { "type": { "const": "obs" }, "op": { "enum": ["record_toggle","stream_toggle","scene","input_mute_toggle","save_replay"] },
      "scene": { "type": "string", "minLength": 1, "maxLength": 100 }, "input": { "type": "string", "minLength": 1, "maxLength": 100 } } } ] },
    "Twitch": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["op"], "properties": { "type": { "const": "twitch" }, "op": { "enum": ["clip","announce"] },
      "message": { "type": "string", "minLength": 1, "maxLength": 500 } } } ] },
    "Youtube": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["op"], "properties": { "type": { "const": "youtube" }, "op": { "enum": ["chat","start","end"] },
      "message": { "type": "string", "minLength": 1, "maxLength": 200 } },
      "if": { "properties": { "op": { "const": "chat" } } }, "then": { "required": ["message"] }, "else": { "not": { "required": ["message"] } } } ] },
    "Sequence": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["steps"], "properties": { "type": { "const": "sequence" }, "steps": { "type": "array", "minItems": 1, "maxItems": 10,
      "items": { "oneOf": [
        { "type": "object", "required": ["actionId"], "additionalProperties": false, "properties": { "actionId": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" } } },
        { "type": "object", "required": ["delayMs"], "additionalProperties": false, "properties": { "delayMs": { "type": "integer", "minimum": 50, "maximum": 10000 } } } ] } } } } ] },
    "Screenshot": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["area"], "properties": { "type": { "const": "screenshot" }, "area": { "enum": ["screen","window","region"] } } } ] },
    "Http": { "allOf": [ { "$ref": "#/$defs/Base" }, { "required": ["method","url"], "properties": { "type": { "const": "http" }, "method": { "enum": ["GET","POST"] }, "url": { "type": "string", "pattern": "^https?://", "maxLength": 2000 },
      "body": { "type": "string", "maxLength": 4096 }, "headers": { "type": "object", "maxProperties": 10, "propertyNames": { "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]{1,64}$" }, "additionalProperties": { "type": "string", "maxLength": 4096 } } },
      "if": { "properties": { "method": { "const": "GET" } } }, "then": { "not": { "required": ["body"] } } } ] },
    "NotesRecord": { "allOf": [ { "$ref": "#/$defs/Base" }, { "properties": { "type": { "const": "notes_record" } } } ] },
    "Action": { "oneOf": [ { "$ref": "#/$defs/Hotkey" }, { "$ref": "#/$defs/Media" }, { "$ref": "#/$defs/Launch" }, { "$ref": "#/$defs/OpenUrl" }, { "$ref": "#/$defs/System" }, { "$ref": "#/$defs/Audio" }, { "$ref": "#/$defs/Obs" }, { "$ref": "#/$defs/Twitch" }, { "$ref": "#/$defs/Youtube" }, { "$ref": "#/$defs/Sequence" }, { "$ref": "#/$defs/Screenshot" }, { "$ref": "#/$defs/Http" }, { "$ref": "#/$defs/NotesRecord" } ] },
    "ActionsFile": { "type": "object", "required": ["version","actions"],
      "properties": { "version": { "const": 1 }, "actions": { "type": "object", "maxProperties": 200, "propertyNames": { "pattern": "^[a-z0-9_-]{1,64}$" }, "additionalProperties": { "$ref": "#/$defs/Action" } } } }
  }
}
