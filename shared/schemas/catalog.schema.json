{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decka.invalid/schemas/catalog.schema.json",
  "$defs": {
    "Bilingual": { "type": "object", "required": ["en","ru"], "additionalProperties": false, "properties": { "en": { "type": "string", "minLength": 1 }, "ru": { "type": "string", "minLength": 1 } } },
    "CatalogId": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9]+)+$" },
    "Icon": { "type": "string", "pattern": "^(lucide|ph):[a-z0-9-]{1,40}$" },
    "Color": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|\\$accent)$" },
    "State": { "type": "object", "additionalProperties": false, "properties": { "label": { "$ref": "#/$defs/Bilingual" }, "icon": { "$ref": "#/$defs/Icon" }, "color": { "$ref": "#/$defs/Color" } } },
    "Item": { "type": "object", "required": ["id","label","name","icon"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/CatalogId" },
        "label": { "$ref": "#/$defs/Bilingual" }, "name": { "$ref": "#/$defs/Bilingual" },
        "icon": { "$ref": "#/$defs/Icon" }, "color": { "$ref": "#/$defs/Color" },
        "action": { "type": "object", "required": ["type"] },
        "confirm": { "type": "boolean" },
        "ask": { "enum": ["url","keys","obs_scene","obs_input","page","sequence","text"] },
        "popup": { "type": "boolean" },
        "bind": { "type": "object", "required": ["var","states"], "additionalProperties": false,
          "properties": { "var": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" }, "states": { "type": "object", "minProperties": 1, "maxProperties": 8, "additionalProperties": { "$ref": "#/$defs/State" } } } },
        "navigate": { "const": "$back" },
        "widget": { "type": "object", "required": ["kind","w","h"], "additionalProperties": false,
          "properties": { "kind": { "enum": ["clock","sys","statuses","notifications","media","volume","timer","weather","obs","ai","twitch","youtube","context"] }, "w": { "type": "integer", "minimum": 1, "maximum": 8 }, "h": { "type": "integer", "minimum": 1, "maximum": 8 }, "options": { "type": "object" } } },
        "requires": { "enum": ["obs","weather","twitch","youtube"] }
      } },
    "Category": { "type": "object", "required": ["id","name","icon","items"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^[a-z]+$" }, "name": { "$ref": "#/$defs/Bilingual" }, "icon": { "$ref": "#/$defs/Icon" }, "items": { "type": "array", "items": { "$ref": "#/$defs/CatalogId" } } } },
    "CatalogFile": { "type": "object", "required": ["version","categories","items"], "additionalProperties": false,
      "properties": { "version": { "const": 1 }, "categories": { "type": "array", "items": { "$ref": "#/$defs/Category" } }, "items": { "type": "array", "items": { "$ref": "#/$defs/Item" } } } },
    "Set": { "type": "object", "required": ["id","name","description","icon","rows"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" }, "name": { "$ref": "#/$defs/Bilingual" }, "description": { "$ref": "#/$defs/Bilingual" }, "icon": { "$ref": "#/$defs/Icon" },
        "rows": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "oneOf": [ { "$ref": "#/$defs/CatalogId" }, { "type": "null" } ] } } },
        "requires": { "enum": ["obs","weather","twitch","youtube"] } } },
    "SetsFile": { "type": "object", "required": ["version","sets"], "additionalProperties": false,
      "properties": { "version": { "const": 1 }, "sets": { "type": "array", "items": { "$ref": "#/$defs/Set" } } } }
  }
}
